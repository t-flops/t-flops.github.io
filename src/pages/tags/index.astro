---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../utils/posts';

const tags = await getAllTags();
---

<BaseLayout title="Topics" description="Browse t-flops by topic.">
  <a class="back-link" href="/">← all writing</a>
  <h1 style="margin-top:16px;">Browse by topic</h1>
  <p class="lede">Finer-grained than layers — the specific things posts keep coming back to.</p>

  {tags.length === 0 ? (
    <p class="byline">No topics yet.</p>
  ) : (
    <ul class="tag-cloud">
      {tags.map((t) => (
        <li>
          <a class="tag tag-link" href={`/tags/${t.slug}/`}>
            {t.label} <span class="count">{t.posts.length}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
