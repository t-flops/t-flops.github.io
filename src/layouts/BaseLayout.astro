---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Search from '../components/Search.tsx';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'A hand-drawn field guide to AI inference, MLOps, and the infrastructure underneath.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- apply the saved theme before paint so there's no flash; default is light -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('t-flops-theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Gloria+Hallelujah&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />

    {/* Cloudflare Web Analytics (production builds only) */}
    {import.meta.env.PROD && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "5b81c867c55b420dbc8865d4c749e775"}`}
      ></script>
    )}
  </head>
  <body>
    <div class="wrap">
      <header class="site-head">
        <a class="brand" href="/">
          <Logo height={42} />
          <span>t-flops</span>
        </a>
        <div class="head-right">
          <nav>
            <a href="/">Latest</a>
            <a href="/layers">Layers</a>
            <a href="/about">About</a>
          </nav>
          <Search client:idle />
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
            <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
            </svg>
            <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </div>
      </header>

      <slot />

      <footer class="site-foot">
        <p>AI inference · MLOps · infrastructure — drawn by hand, built with Astro + rough.js.</p>
      </footer>
    </div>

    <!-- Draw sketchy borders around anything marked [data-sketch-frame].
         Runs client-side, redraws on resize and on light/dark change. -->
    <script>
      import rough from 'roughjs';

      function cssVar(name: string) {
        return (
          getComputedStyle(document.documentElement).getPropertyValue(name).trim() || '#333'
        );
      }

      function sketchFrames() {
        document.querySelectorAll<HTMLElement>('[data-sketch-frame]').forEach((host) => {
          let svg = host.querySelector<SVGSVGElement>(':scope > svg.sketch-border');
          if (!svg) {
            svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            svg.setAttribute('class', 'sketch-border');
            svg.setAttribute('preserveAspectRatio', 'none');
            host.prepend(svg);
          }
          const w = host.clientWidth;
          const h = host.clientHeight;
          if (!w || !h) return;
          svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
          svg.innerHTML = '';
          const rc = rough.svg(svg);
          const shape = host.getAttribute('data-sketch-frame') || 'rect';
          const stroke = cssVar(host.getAttribute('data-sketch-stroke') || '--ink-soft');
          if (shape === 'circle') {
            svg.appendChild(
              rc.ellipse(w / 2, h / 2, w - 6, h - 6, {
                stroke,
                strokeWidth: 2.2,
                roughness: 1.6,
                bowing: 1.2,
              })
            );
          } else {
            svg.appendChild(
              rc.rectangle(3, 3, w - 6, h - 6, {
                stroke,
                strokeWidth: 1.6,
                roughness: 1.8,
                bowing: 1.5,
              })
            );
          }
        });
      }

      let t: number | undefined;
      function schedule() {
        window.clearTimeout(t);
        t = window.setTimeout(sketchFrames, 150);
      }

      window.addEventListener('load', sketchFrames);
      window.addEventListener('resize', schedule);
      // redraw borders when the reader flips the light/dark toggle
      window.addEventListener('t-flops:themechange', sketchFrames);
      // run once in case 'load' already fired
      sketchFrames();
    </script>

    <!-- light/dark toggle: default is light, choice is remembered -->
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        function current() {
          return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        }
        function sync(t) {
          btn.setAttribute('aria-label', t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
          btn.setAttribute('aria-pressed', String(t === 'dark'));
        }
        function apply(t) {
          document.documentElement.setAttribute('data-theme', t);
          try { localStorage.setItem('t-flops-theme', t); } catch (e) {}
          sync(t);
          window.dispatchEvent(new CustomEvent('t-flops:themechange'));
        }
        btn.addEventListener('click', function () {
          apply(current() === 'dark' ? 'light' : 'dark');
        });
        sync(current());
      })();
    </script>
  </body>
</html>
