---
import BaseLayout from './BaseLayout.astro';
import { slugifyTag, layerMeta, getLayerSiblings, type LayerSlug } from '../utils/posts';

interface Props {
  id: string;
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    layer: LayerSlug;
    tags?: string[];
  };
}
const { id, frontmatter } = Astro.props;
const layer = layerMeta(frontmatter.layer);
const siblings = await getLayerSiblings(id, frontmatter.layer, 3);

const date = new Date(frontmatter.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article>
    <a class="back-link" href="/">← all writing</a>
    <div class="eyebrow" style="margin-top:16px;">
      <a href={`/layers/${layer.slug}/`} style="color:inherit;text-decoration:none;">{layer.code} · {layer.name}</a>
      <span class="dot">·</span> {date}
    </div>
    <h1>{frontmatter.title}</h1>
    {frontmatter.tags?.length ? (
      <div class="post-tags">
        {frontmatter.tags.map((t) => (
          <a class="tag tag-link" href={`/tags/${slugifyTag(t)}/`}>{t}</a>
        ))}
      </div>
    ) : null}
    <div class="prose">
      <slot />
    </div>

    {siblings.length > 0 && (
      <>
        <div class="section-label">More in {layer.name}</div>
        <ul class="post-list">
          {siblings.map((p) => (
            <li class="post-card" data-sketch-frame>
              <a class="card-title" href={`/posts/${p.id}`}>{p.data.title}</a>
              <p>{p.data.description}</p>
            </li>
          ))}
        </ul>
      </>
    )}
  </article>
</BaseLayout>
