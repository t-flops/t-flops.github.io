---
// t-flops mark: a schematic processor die drawn like a blueprint part —
// a double-stroked square with pin ticks on every side, a cyan compute
// node at its center (the multiply-accumulate core where FLOPs happen),
// and a small amber spark for the heat it throws. Colors come from CSS
// tokens, so it follows light/dark. Draws itself in on load.
interface Props {
  height?: number;
  class?: string;
}
const { height = 42, class: className = '' } = Astro.props;
const width = Math.round((height * 48) / 52);
---

<svg
  class:list={['tf-logo', className]}
  width={width}
  height={height}
  viewBox="0 0 48 52"
  fill="none"
  role="img"
  aria-label="t-flops logo — a schematic processor die with a compute node"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <!-- pins -->
  <g class="tf-pins" stroke="var(--ink-soft)" stroke-width="2">
    <line x1="18" y1="12" x2="18" y2="7" /><line x1="24" y1="12" x2="24" y2="7" /><line x1="30" y1="12" x2="30" y2="7" />
    <line x1="18" y1="40" x2="18" y2="45" /><line x1="24" y1="40" x2="24" y2="45" /><line x1="30" y1="40" x2="30" y2="45" />
    <line x1="10" y1="20" x2="5" y2="20" /><line x1="10" y1="26" x2="5" y2="26" /><line x1="10" y1="32" x2="5" y2="32" />
    <line x1="38" y1="20" x2="43" y2="20" /><line x1="38" y1="26" x2="43" y2="26" /><line x1="38" y1="32" x2="43" y2="32" />
  </g>

  <!-- die body (drawn twice = sketchy) -->
  <rect class="tf-die" x="10" y="12" width="28" height="28" rx="3"
        stroke="var(--ink)" stroke-width="2.6" fill="var(--panel)" />
  <rect class="tf-die2" x="10.7" y="12.7" width="26.6" height="26.6" rx="3"
        stroke="var(--ink)" stroke-width="1.2" opacity="0" />

  <!-- compute node -->
  <circle class="tf-node" cx="24" cy="26" r="3.4" fill="var(--accent2)" stroke="var(--panel)" stroke-width="1" />

  <!-- spark -->
  <g class="tf-spark" stroke="var(--hot)" stroke-width="2">
    <line x1="33" y1="16" x2="33" y2="20" /><line x1="31" y1="18" x2="35" y2="18" />
  </g>
</svg>

<style>
  .tf-die {
    stroke-dasharray: 120; stroke-dashoffset: 120;
    animation: tf-draw 0.9s ease forwards;
  }
  .tf-die2 { animation: tf-fade 0.5s ease 0.6s forwards; }
  .tf-pins {
    stroke-dasharray: 6; stroke-dashoffset: 6;
    animation: tf-draw 0.6s ease 0.45s forwards;
  }
  .tf-node {
    transform-box: fill-box; transform-origin: center; transform: scale(0);
    animation: tf-pop 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) 0.7s both;
  }
  .tf-spark {
    transform-box: fill-box; transform-origin: center; transform: scale(0) rotate(-20deg);
    animation: tf-pop 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) 1s both;
  }

  @keyframes tf-draw { to { stroke-dashoffset: 0; } }
  @keyframes tf-fade { to { opacity: 0.45; } }
  @keyframes tf-pop { to { transform: scale(1) rotate(0deg); } }

  /* hover: the compute node pulses */
  :global(.brand):hover .tf-node,
  .tf-logo:hover .tf-node { animation: tf-blink 1s steps(1) infinite; }
  @keyframes tf-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  @media (prefers-reduced-motion: reduce) {
    .tf-die { stroke-dashoffset: 0; animation: none; }
    .tf-die2 { opacity: 0.45; animation: none; }
    .tf-pins { stroke-dashoffset: 0; animation: none; }
    .tf-node { transform: scale(1); animation: none; }
    .tf-spark { transform: scale(1) rotate(0deg); animation: none; }
  }
</style>
